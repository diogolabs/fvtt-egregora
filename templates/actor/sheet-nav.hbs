<nav class="eg-sheet-nav">
  <button type="button" class="eg-nav-tab {{#if (eq activeTab 'main')}}active{{/if}}" data-action="switchTab" data-tab="main">
    <i class="fa-solid fa-scroll"></i> {{localize "EGREGORA.Tabs.Sheet"}}
  </button>
  <button type="button" class="eg-nav-tab {{#if (eq activeTab 'occult')}}active{{/if}}" data-action="switchTab" data-tab="occult">
    <i class="fa-solid fa-eye"></i> {{localize "EGREGORA.Tabs.Occult"}}
  </button>
  <button type="button" class="eg-nav-tab {{#if (eq activeTab 'biography')}}active{{/if}}" data-action="switchTab" data-tab="biography">
    <i class="fa-solid fa-book-open"></i> {{localize "EGREGORA.Tabs.Biography"}}
  </button>
  <button type="button" class="eg-nav-tab {{#if (eq activeTab 'effects')}}active{{/if}}" data-action="switchTab" data-tab="effects">
    <i class="fa-solid fa-bolt"></i> {{localize "EGREGORA.Tabs.Effects"}}
  </button>
  {{#if isBroken}}
    <span class="eg-broken-pill"><i class="fa-solid fa-heart-crack"></i> {{localize "EGREGORA.Broken"}}</span>
  {{/if}}
  {{#if enableDoomPoints}}
    <span class="eg-doom-pill" title="{{localize 'EGREGORA.DoomPoint'}}">
      <i class="fa-solid fa-skull"></i> {{localize "EGREGORA.DoomPointsShort"}}: {{doomPoints}}
    </span>
  {{/if}}
</nav>
