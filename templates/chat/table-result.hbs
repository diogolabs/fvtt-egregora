<div class="eg-chat-card eg-table-card {{#if isAlert}}is-alert{{/if}}">
  <header class="eg-table-header">
    <h3>{{tableTitle}}</h3>
    <span class="eg-table-roll-pill">{{rollLabel}}</span>
  </header>
  <div class="eg-table-body">
    <h4 class="eg-table-result-title">{{resultTitle}}</h4>
    <p>{{resultText}}</p>
    {{#if metaLine}}<div class="eg-table-meta">{{metaLine}}</div>{{/if}}
  </div>
</div>
