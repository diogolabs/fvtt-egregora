<div class="eg-dialog-body">
  <div class="eg-roll-preview">
    <span class="eg-preview-label">{{localize "EGREGORA.Magic.TotalDice"}}</span>
    <strong class="eg-preview-formula">{{totalDice}}D6 ({{localize (lookup config.attributes attribute)}} {{attrVal}} + {{localize "EGREGORA.Magic.EffectivePath"}} {{effectivePath}})</strong>
  </div>

  <div class="eg-form-grid-2">
    <label class="eg-field eg-span-2">
      <span>{{localize "EGREGORA.Magic.SpellName"}}</span>
      <input type="text" name="spellName" value="{{spellName}}" placeholder="{{localize 'EGREGORA.Magic.FreeformPlaceholder'}}" />
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.Attribute.Label"}}</span>
      <select name="attribute">
        {{#each config.attributes as |labelKey key|}}
          <option value="{{key}}" {{#if (eq ../attribute key)}}selected{{/if}}>{{localize labelKey}}</option>
        {{/each}}
      </select>
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.Magic.PrimaryPath"}}</span>
      <select name="primaryPath">
        {{#each config.magicPaths as |labelKey key|}}
          <option value="{{key}}" {{#if (eq ../primaryPath key)}}selected{{/if}}>{{localize labelKey}}</option>
        {{/each}}
      </select>
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.Magic.SecondaryPath"}}</span>
      <select name="secondaryPath">
        <option value="">—</option>
        {{#each config.magicPaths as |labelKey key|}}
          <option value="{{key}}" {{#if (eq ../secondaryPath key)}}selected{{/if}}>{{localize labelKey}}</option>
        {{/each}}
      </select>
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.Magic.CostSource"}}</span>
      <select name="costPool">
        <option value="willpower" {{#if (eq costPool "willpower")}}selected{{/if}}>{{localize "EGREGORA.Magic.CostPool.willpower"}} ({{wpAvailable}})</option>
        <option value="mental" {{#if (eq costPool "mental")}}selected{{/if}}>{{localize "EGREGORA.Magic.CostPool.mental"}} ({{pmAvailable}})</option>
        <option value="health" {{#if (eq costPool "health")}}selected{{/if}}>{{localize "EGREGORA.Magic.CostPool.health"}} ({{hpAvailable}})</option>
      </select>
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.Magic.CostAmount"}}</span>
      <input type="number" name="costAmount" value="{{costAmount}}" min="1" max="10" />
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.Magic.FetishBonus"}}</span>
      <input type="number" name="fetishBonus" value="{{fetishBonus}}" min="0" max="5" />
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.RollDialog.CorruptionDice"}}</span>
      <input type="number" name="corruptionDice" value="{{corruptionDice}}" min="0" max="5" />
    </label>

    <label class="eg-field">
      <span>{{localize "EGREGORA.Modifier"}}</span>
      <input type="number" name="modifier" value="{{modifier}}" />
    </label>
  </div>

  <div class="eg-checkbox-strip">
    <label class="eg-check-field">
      <input type="checkbox" name="directDamage" {{checked directDamage}} />
      <span>{{localize "EGREGORA.Magic.DirectDamage"}}</span>
    </label>
  </div>

  <footer class="eg-dialog-footer">
    <button type="submit" class="eg-btn eg-btn-crimson">
      <i class="fa-solid fa-wand-sparkles"></i> {{localize "EGREGORA.Magic.Cast"}}
    </button>
  </footer>
</div>
